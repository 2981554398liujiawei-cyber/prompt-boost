# ═══════════════════════════════════════════════════════════════
# Prompt Boost — environment variables
# Copy to `.env` (git-ignored) and adjust for your machine.
#
# IMPORTANT: These variables configure the LOCAL AGENT on this machine.
# Your AI provider API keys are entered in the extension's Options page
# and stored in the OS credential vault (see docs/SECURITY.md) — never here.
# ═══════════════════════════════════════════════════════════════

# Local agent host/port. Only loopback is supported.
LOCAL_AGENT_HOST=127.0.0.1
LOCAL_AGENT_PORT=8787

# Absolute path to the SQLite data file. Relative paths resolve against
# the local-agent working directory. Omit for `./data/prompt-boost.db`.
# LOCAL_AGENT_DB_PATH=

# The auth token is generated automatically on first run and written to
# `data/.auth-token`. Set one explicitly only to share a stable token
# across dev restarts. MIN_LENGTH enforced: 16 characters.
# LOCAL_AGENT_AUTH_TOKEN=

# Development toggle. When "true", the local agent logs full request
# bodies (prompt text) to stdout. NEVER enable in production.
# LOG_VERBOSE=false
