{
  "name": "@prompt-boost/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prompt Boost — Chrome MV3 extension",
  "scripts": {
    "dev": "vite build --config vite.pages.config.ts --watch",
    "build": "vite build --config vite.pages.config.ts && vite build --config vite.content.config.ts && vite build --config vite.background.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "test": "vitest --run",
    "test:run": "vitest --run",
    "clean": "rimraf dist .vite"
  },
  "dependencies": {
    "@prompt-boost/prompt-core": "workspace:*",
    "@prompt-boost/shared": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.5"
  }
}
