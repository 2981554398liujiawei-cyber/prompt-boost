{
  "manifest_version": 3,
  "name": "Prompt Boost",
  "description": "在 ChatGPT 输入框旁一键增强你的 Prompt：分析、补全、润色，写回输入框（BYOK，本地服务托管密钥）。",
  "version": "0.1.2",
  "version_name": "0.1.2 (cascade menu fix)",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1:8787/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Prompt Boost",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
