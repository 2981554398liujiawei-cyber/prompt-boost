{
  "name": "prompt-boost",
  "version": "0.1.0",
  "private": true,
  "description": "Prompt Boost — AI prompt enhancement Chrome extension for ChatGPT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "pnpm -r format",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:run": "pnpm -r test:run",
    "clean": "pnpm -r clean",
    "agent:dev": "pnpm --filter @prompt-boost/local-agent dev",
    "agent:start": "pnpm --filter @prompt-boost/local-agent start",
    "agent:token:show": "pnpm --filter @prompt-boost/local-agent token:show",
    "agent:token:rotate": "pnpm --filter @prompt-boost/local-agent token:rotate",
    "check": "pnpm lint && pnpm typecheck && pnpm test:run && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/eslint": "^9.6.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  },
  "packageManager": "pnpm@11.20.0"
}
